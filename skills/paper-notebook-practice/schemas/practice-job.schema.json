{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper Notebook Agent Job",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "practice-job"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "mock",
        "bank"
      ]
    },
    "intent": {
      "enum": [
        "generate",
        "original",
        "adapt"
      ]
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "targetScore": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "templateOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paperSize": {
          "enum": [
            "A4",
            "A3"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "columns": {
          "enum": [
            1,
            2
          ]
        },
        "headerVariant": {
          "enum": [
            "standard",
            "gaokao",
            "university",
            "professional",
            "computer",
            "ielts",
            "language"
          ]
        },
        "fontFamily": {
          "enum": [
            "song",
            "times",
            "sans"
          ]
        },
        "headingNumbering": {
          "enum": [
            "chinese",
            "arabic",
            "roman"
          ]
        },
        "answerMode": {
          "enum": [
            "separate",
            "inline"
          ]
        },
        "marginTopMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 70
        },
        "marginBottomMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 70
        },
        "marginLeftMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 70
        },
        "marginRightMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 70
        },
        "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 22
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1.1,
          "maximum": 2.5
        },
        "showSeal": {
          "type": "boolean"
        },
        "institution": {
          "type": "string"
        },
        "examCode": {
          "type": "string"
        },
        "footerText": {
          "type": "string"
        },
        "widthMm": {
          "type": "number",
          "minimum": 100,
          "maximum": 600
        },
        "heightMm": {
          "type": "number",
          "minimum": 100,
          "maximum": 600
        }
      }
    },
    "seed": {
      "type": "string"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "search": {
          "type": "string"
        },
        "chapter": {
          "type": "string"
        },
        "type": {
          "enum": [
            "choice",
            "multiple",
            "truefalse",
            "blank",
            "response",
            "task"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "instructions": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "choice",
                "multiple",
                "truefalse",
                "blank",
                "response",
                "task"
              ]
            }
          },
          "chapters": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "questionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pointsPerQuestion": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "title",
          "count"
        ]
      }
    },
    "selectedQuestionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "balanceChoices": {
      "type": "boolean"
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ready",
            "needs-review",
            "needs-ocr"
          ]
        }
      },
      "required": [
        "manifest",
        "status"
      ]
    },
    "requirements": {
      "type": "string"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ocrReviewed": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "ocrReviewed",
        "unresolved",
        "notes"
      ]
    },
    "examId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "full",
        "subset"
      ]
    },
    "specification": {
      "type": "object",
      "required": [
        "id",
        "name",
        "subject",
        "level",
        "durationMinutes",
        "totalScore",
        "scoreScale",
        "sections"
      ]
    },
    "customization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watermark": {
          "enum": [
            "source",
            "none",
            "custom"
          ]
        },
        "integrity": {
          "enum": [
            "source",
            "none",
            "standard",
            "custom"
          ]
        },
        "security": {
          "enum": [
            "source",
            "none",
            "custom"
          ]
        },
        "candidateFields": {
          "enum": [
            "source",
            "standard",
            "none"
          ]
        },
        "binding": {
          "enum": [
            "source",
            "binding",
            "none"
          ]
        },
        "scoreTable": {
          "enum": [
            "source",
            "show",
            "hide"
          ]
        },
        "paperSize": {
          "enum": [
            "source",
            "A4",
            "A3"
          ]
        },
        "watermarkText": {
          "type": "string",
          "maxLength": 200
        },
        "integrityText": {
          "type": "string",
          "maxLength": 4000
        },
        "securityText": {
          "type": "string",
          "maxLength": 200
        },
        "courseCode": {
          "type": "string",
          "maxLength": 100
        },
        "institution": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 8000
        },
        "projectMark": {
          "type": "boolean",
          "description": "Show the removable linked GitHub project credit at the bottom-right of each generated page; defaults to true. Independent of source watermark."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "watermark": {
                "const": "custom"
              }
            },
            "required": [
              "watermark"
            ]
          },
          "then": {
            "properties": {
              "watermarkText": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "watermarkText"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "security": {
                "const": "custom"
              }
            },
            "required": [
              "security"
            ]
          },
          "then": {
            "properties": {
              "securityText": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "securityText"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "integrity": {
                "const": "custom"
              }
            },
            "required": [
              "integrity"
            ]
          },
          "then": {
            "properties": {
              "integrityText": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "integrityText"
            ]
          }
        }
      ]
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeId": {
          "type": "string",
          "minLength": 1
        },
        "examName": {
          "type": "string",
          "minLength": 1
        },
        "examCode": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "specialty": {
          "type": "string",
          "minLength": 1
        },
        "profileIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "source",
            "easy",
            "balanced",
            "hard"
          ]
        },
        "knowledge": {
          "type": "string",
          "minLength": 1
        },
        "requireVerification": {
          "type": "boolean"
        },
        "blueprint": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "knowledge": {
                "type": "string",
                "minLength": 1
              },
              "ability": {
                "type": "string",
                "minLength": 1
              },
              "types": {
                "type": "array",
                "items": {
                  "enum": [
                    "choice",
                    "multiple",
                    "truefalse",
                    "blank",
                    "response",
                    "task"
                  ]
                },
                "minItems": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "estimatedMinutes": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "knowledge",
              "ability",
              "count"
            ]
          },
          "minItems": 1
        }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "uploads-only",
            "uploads-first",
            "open"
          ]
        },
        "requiredMaterialIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedMaterialIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excludedMaterialIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "questionPreference": {
          "enum": [
            "originals-first",
            "balanced",
            "generated-first"
          ]
        },
        "requiredVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "materialId": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "materialId",
              "version"
            ]
          }
        }
      },
      "required": [
        "mode"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "title",
    "subject",
    "level",
    "mode",
    "intent",
    "durationMinutes",
    "count",
    "seed",
    "balanceChoices",
    "requirements",
    "quality"
  ]
}
